# Supabase credentials for local development.
#
# Where to get these values:
#   1. Go to https://supabase.com/dashboard and open your project
#   2. Click "Settings" (gear icon) in the left sidebar
#   3. Click "API"
#   4. Copy "Project URL" -> paste it after the = below (no quotes)
#   5. Copy "anon" "public" key (NOT the "service_role" key) -> paste it below
#
# After editing this file, restart `npm run dev` for the changes to take effect.
# This file is already excluded from git (see .gitignore) so your keys are
# never accidentally committed or pushed.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
